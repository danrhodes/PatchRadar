<Window x:Class="PatchRadar.Views.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PatchRadar" Width="620" Height="680" MinWidth="380" MinHeight="300"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="12">
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="UninstallButton" Content="Uninstall…" Padding="12,4" Margin="0,0,8,6" Click="Uninstall_Click" Visibility="Collapsed" ToolTip="Administrators only. Remove this update from this PC."/>
            <Button x:Name="ReviewButton" Content="Mark reviewed" Padding="12,4" Margin="0,0,8,6" Click="Review_Click"/>
            <Button x:Name="OpenButton" Content="Open KB article" Padding="12,4" Margin="0,0,8,6" IsDefault="True" Click="Open_Click"/>
            <Button x:Name="CopyButton" Content="Copy summary" Padding="12,4" Margin="0,0,8,6" Click="Copy_Click"/>
            <Button x:Name="RefreshButton" Content="Refresh" Padding="12,4" Margin="0,0,0,6" Click="Refresh_Click"/>
        </WrapPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Body"/>
        </ScrollViewer>
    </DockPanel>
</Window>
